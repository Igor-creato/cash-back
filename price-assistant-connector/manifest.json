{
  "manifest_version": 3,
  "name": "Savello Price Assistant Connector",
  "version": "0.1.0",
  "description": "Captures allowlisted marketplace session cookies only after explicit user consent.",
  "permissions": ["cookies", "storage"],
  "optional_host_permissions": [
    "https://*.ozon.ru/*",
    "https://*.wildberries.ru/*",
    "https://market.yandex.ru/*",
    "https://*.market.yandex.ru/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://savelloclub.ru/*",
        "https://*.savelloclub.ru/*",
        "https://savelloclub.test/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
